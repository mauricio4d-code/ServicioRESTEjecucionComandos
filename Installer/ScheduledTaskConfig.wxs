<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!--
      Scheduled Task configuration is handled by PowerShell custom actions.
      This Fragment provides a placeholder component for tracking whether
      the scheduled task was installed (for proper uninstall tracking).
    -->
    <Component Id="ScheduledTaskConfigComponent" Directory="INSTALLFOLDER" Guid="*">
      <RegistryKey Root="HKLM" Key="SOFTWARE\ServicioRESTEjecucionComandos\ScheduledTask">
        <RegistryValue Name="TaskName" Value="ServicioRESTEjecucionComandos.HealthMonitor" Type="string" />
        <RegistryValue Name="Installed" Value="[InstallScheduledTask]" Type="string" />
      </RegistryKey>
    </Component>
  </Fragment>
</Wix>
