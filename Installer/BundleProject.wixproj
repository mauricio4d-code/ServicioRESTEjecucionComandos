<Project Sdk="WixToolset.Sdk/4.0.6">

  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <AppVersion>1.0.0</AppVersion>
    <PublishOutputPath>publish</PublishOutputPath>
    <MsiOutputPath>$(OutDir)MsiProject.msi</MsiOutputPath>
    <DefineConstants>PublishOutputPath=$(PublishOutputPath);MsiOutputPath=$(MsiOutputPath)</DefineConstants>
    <DefaultItemExcludes>$(DefaultItemExcludes);Product.wxs;CustomActions.wxs;ServiceConfig.wxs;ScheduledTaskConfig.wxs;UI.wxs</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="4.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="MsiProject.wixproj" />
  </ItemGroup>

</Project>