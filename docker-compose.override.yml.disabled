version: "3.8"

services:
  servicio-rest:
    build:
      context: .
      dockerfile: Dockerfile
    environment:
      - ASPNETCORE_ENVIRONMENT=Development
      - ASPNETCORE_URLS=http://0.0.0.0:5000
    volumes:
      - .:/src
    working_dir: /src
    command: >
      sh -c "dotnet restore &&
             dotnet run --project ServicioRESTEjecucionComandos.csproj"
    ports:
      - "5000:5000"
