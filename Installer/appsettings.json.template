{
    "DataxConfig": {
        "ExePath": "__DATAEXEPATH__"
    },
    "QueueConfig": {
        "WaitSeconds": 10,
        "MaxParallelExecutions": 1,
        "DailyCodes": ["__DAILYCODES__"],
        "ExcludedCodes": ["__EXCLUDEDCODES__"]
    },
    "ServiceDb": {
        "Provider": "__SERVICE_DB_PROVIDER__"
    },
    "Authentication": {
        "Provider": "__AUTH_DB_PROVIDER__"
    },
    "ConnectionStrings": {
        "AuthDatabase": "__AUTH_DB_CONNECTION_STRING__",
        "RefreshTokenDatabase": "Data Source=ServicioRESTEjecucionComandos.db",
        "ServiceDatabase": "__SERVICE_DB_CONNECTION_STRING__"
    },
    "Jwt": {
        "SecretKey": "__JWT_SECRET_KEY__",
        "Issuer": "ServicioRESTEjecucionComandos",
        "Audience": "ServicioRESTEjecucionComandosClient",
        "AccessTokenMinutes": __JWT_ACCESS_TOKEN_MINUTES__,
        "RefreshTokenDays": __JWT_REFRESH_TOKEN_DAYS__
    },
    "RefreshTokenCleanup": {
        "CleanupIntervalMinutes": 60,
        "AuditLogRetentionDays": 90
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
                "Microsoft.EntityFrameworkCore.Query": "Warning",
                "Microsoft.Hosting.Lifetime": "Information"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "__LOGS_PATH__/log-.txt",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 30,
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    },
    "AllowedHosts": "*",
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://localhost:__SERVICE_PORT__"
            }
        }
    }
}
