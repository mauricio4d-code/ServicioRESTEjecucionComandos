<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?define ProductName = "ServicioRESTEjecucionComandos" ?>
  <?define Manufacturer = "SAFI" ?>
  <?define ProductVersion = "1.0.0" ?>
  <?define UpgradeCode = "A1B2C3D4-E5F6-7890-ABCD-EF1234567890" ?>
  <?define DefaultInstallFolder = "C:\Program Files\ServicioRESTEjecucionComandos" ?>
  <?define PublishPath = "publish" ?>

  <Package
      Name="$(var.ProductName)"
      Language="1033"
      Version="$(var.ProductVersion)"
      Manufacturer="$(var.Manufacturer)"
      InstallerVersion="500"
      Compressed="yes"
      UpgradeCode="$(var.UpgradeCode)">

    <!-- Major upgrade support -->
    <Upgrade Id="$(var.UpgradeCode)">
      <UpgradeVersion
          Minimum="0.0.1"
          Maximum="99.0.0"
          Property="PREVIOUSVERSIONSINSTALLED"
          IncludeMinimum="yes"
          IncludeMaximum="no"
          MigrateFeatures="yes" />
    </Upgrade>

    <!-- Properties with defaults -->
    <Property Id="INSTALLFOLDER" Value="$(var.DefaultInstallFolder)" />
    <Property Id="ServicePort" Value="5000" />
    <Property Id="AuthDbProvider" Value="sqlite" />
    <Property Id="AuthDbConnectionString" Hidden="yes" />
    <Property Id="ServiceDbProvider" Value="postgres" />
    <Property Id="ServiceDbConnectionString" Hidden="yes" />
    <Property Id="DataxExePath" Hidden="yes" />
    <Property Id="DailyCodes" Hidden="yes" />
    <Property Id="ExcludedCodes" Hidden="yes" />
    <Property Id="JwtSecretKey" Hidden="yes" />
    <Property Id="JwtAccessTokenMinutes" Value="5" />
    <Property Id="JwtRefreshTokenDays" Value="30" />
    <Property Id="LogsPath" Value="C:\Program Files\ServicioRESTEjecucionComandos\Logs" />
    <Property Id="StartServiceAfterInstall" Value="1" />
    <Property Id="InstallScheduledTask" Value="0" />
    <Property Id="SmtpServer" Hidden="yes" />
    <Property Id="SmtpPort" Value="587" />
    <Property Id="EmailFrom" Hidden="yes" />
    <Property Id="EmailUsername" Hidden="yes" />
    <Property Id="EmailPassword" Hidden="yes" />
    <Property Id="EmailRecipients" Hidden="yes" />

    <!-- Directory structure -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)">
        <Directory Id="LogsDir" Name="Logs" />
      </Directory>
    </StandardDirectory>

    <!-- Features -->
    <Feature Id="Complete" Title="Complete Installation" Description="Install all components." Level="1" ConfigurableDirectory="INSTALLFOLDER" AllowAdvertise="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="ConfigFiles" />
      <ComponentRef Id="LogsFolder" />
      <ComponentRef Id="CustomActionsComponent" />
      <ComponentRef Id="ServiceConfigComponent" />
      <ComponentRef Id="ScheduledTaskConfigComponent" />
    </Feature>

    <!-- Application files component group -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="AppMainExe" Guid="*">
        <File Source="$(var.PublishPath)\ServicioRESTEjecucionComandos.exe" KeyPath="yes" />
      </Component>
      <Component Id="AppMainDll" Guid="*">
        <File Source="$(var.PublishPath)\ServicioRESTEjecucionComandos.dll" KeyPath="yes" />
      </Component>
      <Component Id="MonitorScript" Guid="*">
        <File Source="$(var.PublishPath)\Monitor-Health.ps1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Config template component group -->
    <ComponentGroup Id="ConfigFiles" Directory="INSTALLFOLDER">
      <Component Id="AppSettingsTemplate" Guid="*">
        <File Source="appsettings.json.template" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Logs folder component -->
    <Component Id="LogsFolder" Directory="LogsDir" Guid="{A1B2C3D4-E5F6-7890-ABCD-EF1234567891}">
      <CreateFolder />
    </Component>

    <!-- Custom Actions component (holds embedded scripts) -->
    <Component Id="CustomActionsComponent" Directory="INSTALLFOLDER" Guid="*">
      <RegistryKey Root="HKLM" Key="SOFTWARE\ServicioRESTEjecucionComandos">
        <RegistryValue Name="InstallFolder" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
      </RegistryKey>
    </Component>

    <!-- ===================== UI Definition ===================== -->
    <UI Id="CustomWixUI">
      <!-- Dialog sequence references -->
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="InstallDirDlg" />
      <DialogRef Id="ServiceConfigDlg" />
      <DialogRef Id="DatabaseConfigDlg" />
      <DialogRef Id="AuthConfigDlg" />
      <DialogRef Id="EtlConfigDlg" />
      <DialogRef Id="MonitorConfigDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="FinishDlg" />
      <DialogRef Id="CancelDlg" />
      <DialogRef Id="ErrorDlg" />

      <!-- Publish events for navigation -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ServiceConfigDlg" Order="1" />
      <Publish Dialog="ServiceConfigDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1" />
      <Publish Dialog="ServiceConfigDlg" Control="Next" Event="NewDialog" Value="DatabaseConfigDlg" Order="1" />
      <Publish Dialog="DatabaseConfigDlg" Control="Back" Event="NewDialog" Value="ServiceConfigDlg" Order="1" />
      <Publish Dialog="DatabaseConfigDlg" Control="Next" Event="NewDialog" Value="AuthConfigDlg" Order="1" />
      <Publish Dialog="AuthConfigDlg" Control="Back" Event="NewDialog" Value="DatabaseConfigDlg" Order="1" />
      <Publish Dialog="AuthConfigDlg" Control="Next" Event="NewDialog" Value="EtlConfigDlg" Order="1" />
      <Publish Dialog="EtlConfigDlg" Control="Back" Event="NewDialog" Value="AuthConfigDlg" Order="1" />
      <Publish Dialog="EtlConfigDlg" Control="Next" Event="NewDialog" Value="MonitorConfigDlg" Order="1" />
      <Publish Dialog="MonitorConfigDlg" Control="Back" Event="NewDialog" Value="EtlConfigDlg" Order="1" />
      <Publish Dialog="MonitorConfigDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MonitorConfigDlg" Order="1" />
      <Publish Dialog="VerifyReadyDlg" Control="Install" Event="EndDialog" Value="Return" Order="1" />
      <Publish Dialog="FinishDlg" Control="Finish" Event="EndDialog" Value="Return" Order="1" />

      <!-- ===================== Dialog Definitions ===================== -->

      <!-- Welcome Dialog -->
      <Dialog Id="WelcomeDlg" Width="370" Height="270" Title="Welcome to [ProductName] Setup">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Title" Type="Text" X="135" Y="80" Width="220" Height="30" NoPrefix="yes" Transparent="yes" Text="{\WixUIHeader}[ProductName]" />
        <Control Id="Description" Type="Text" X="20" Y="110" Width="330" Height="60" NoPrefix="yes" Transparent="yes" Text="This wizard will install [ProductName] on your computer. Click Next to continue." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <!-- Install Directory Dialog -->
      <Dialog Id="InstallDirDlg" Width="370" Height="270" Title="Installation Folder">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Title" Type="Text" X="135" Y="80" Width="220" Height="30" NoPrefix="yes" Transparent="yes" Text="{\WixUIHeader}Installation Folder" />
        <Control Id="Description" Type="Text" X="20" Y="110" Width="330" Height="20" NoPrefix="yes" Transparent="yes" Text="Select the folder where [ProductName] will be installed." />
        <Control Id="PathLabel" Type="Text" X="20" Y="135" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="Installation folder:" />
        <Control Id="PathEdit" Type="PathEdit" X="20" Y="150" Width="300" Height="17" Property="INSTALLFOLDER" />
        <Control Id="LogsLabel" Type="Text" X="20" Y="175" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="Logs folder:" />
        <Control Id="LogsEdit" Type="Edit" X="20" Y="190" Width="300" Height="17" Property="LogsPath" />
      </Dialog>

      <!-- Service Configuration Dialog -->
      <Dialog Id="ServiceConfigDlg" Width="370" Height="270" Title="Service Configuration">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Title" Type="Text" X="135" Y="80" Width="220" Height="30" NoPrefix="yes" Transparent="yes" Text="{\WixUIHeader}Service Configuration" />
        <Control Id="PortLabel" Type="Text" X="20" Y="110" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="Service Port (default: 5000):" />
        <Control Id="PortEdit" Type="Edit" X="20" Y="125" Width="100" Height="17" Property="ServicePort" />
        <Control Id="StartServiceLabel" Type="Text" X="20" Y="155" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="Start service after installation:" />
        <Control Id="StartServiceCheck" Type="CheckBox" X="20" Y="170" Width="250" Height="17" Property="StartServiceAfterInstall" Text="Start the Windows service after installation completes" />
      </Dialog>

      <!-- Database Configuration Dialog -->
      <Dialog Id="DatabaseConfigDlg" Width="370" Height="270" Title="Database Configuration">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Title" Type="Text" X="135" Y="80" Width="220" Height="30" NoPrefix="yes" Transparent="yes" Text="{\WixUIHeader}Database Configuration" />
        <Control Id="AuthDbLabel" Type="Text" X="20" Y="105" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="Auth Database Provider:" />
        <Control Id="AuthDbRadioGroup" Type="RadioButtonGroup" X="20" Y="120" Width="330" Height="45" Property="AuthDbProvider">
          <RadioButtonGroup Property="AuthDbProvider">
            <RadioButton Value="postgres" Text="PostgreSQL" X="20" Y="0" Width="120" Height="15" />
            <RadioButton Value="sqlserver" Text="SQL Server" X="20" Y="15" Width="120" Height="15" />
            <RadioButton Value="sqlite" Text="SQLite" X="20" Y="30" Width="120" Height="15" />
          </RadioButtonGroup>
        </Control>
        <Control Id="AuthConnLabel" Type="Text" X="20" Y="170" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="Auth Connection String:" />
        <Control Id="AuthConnEdit" Type="Edit" X="20" Y="185" Width="330" Height="17" Property="AuthDbConnectionString" />
        <Control Id="SvcDbLabel" Type="Text" X="20" Y="210" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="Service DB Provider:" />
        <Control Id="SvcDbRadioGroup" Type="RadioButtonGroup" X="20" Y="225" Width="330" Height="30" Property="ServiceDbProvider">
          <RadioButtonGroup Property="ServiceDbProvider">
            <RadioButton Value="postgres" Text="PostgreSQL" X="20" Y="0" Width="120" Height="15" />
            <RadioButton Value="sqlserver" Text="SQL Server" X="20" Y="15" Width="120" Height="15" />
          </RadioButtonGroup>
        </Control>
      </Dialog>

      <!-- Authentication (JWT) Configuration Dialog -->
      <Dialog Id="AuthConfigDlg" Width="370" Height="270" Title="Authentication Configuration">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Title" Type="Text" X="135" Y="80" Width="220" Height="30" NoPrefix="yes" Transparent="yes" Text="{\WixUIHeader}Authentication Configuration" />
        <Control Id="JwtKeyLabel" Type="Text" X="20" Y="105" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="JWT Secret Key:" />
        <Control Id="JwtKeyEdit" Type="Edit" X="20" Y="120" Width="330" Height="17" Property="JwtSecretKey" Password="yes" />
        <Control Id="JwtMinutesLabel" Type="Text" X="20" Y="145" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="Access Token Lifetime (minutes):" />
        <Control Id="JwtMinutesEdit" Type="Edit" X="20" Y="160" Width="100" Height="17" Property="JwtAccessTokenMinutes" />
        <Control Id="JwtDaysLabel" Type="Text" X="20" Y="185" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="Refresh Token Lifetime (days):" />
        <Control Id="JwtDaysEdit" Type="Edit" X="20" Y="200" Width="100" Height="17" Property="JwtRefreshTokenDays" />
      </Dialog>

      <!-- ETL Configuration Dialog -->
      <Dialog Id="EtlConfigDlg" Width="370" Height="270" Title="ETL Configuration">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Title" Type="Text" X="135" Y="80" Width="220" Height="30" NoPrefix="yes" Transparent="yes" Text="{\WixUIHeader}ETL Configuration" />
        <Control Id="DataxLabel" Type="Text" X="20" Y="105" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="Datax.SAFI.Downloader.exe path:" />
        <Control Id="DataxEdit" Type="Edit" X="20" Y="120" Width="300" Height="17" Property="DataxExePath" />
        <Control Id="DailyCodesLabel" Type="Text" X="20" Y="145" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="Daily Codes (comma-separated):" />
        <Control Id="DailyCodesEdit" Type="Edit" X="20" Y="160" Width="330" Height="17" Property="DailyCodes" />
        <Control Id="ExcludedCodesLabel" Type="Text" X="20" Y="185" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="Excluded Codes (comma-separated):" />
        <Control Id="ExcludedCodesEdit" Type="Edit" X="20" Y="200" Width="330" Height="17" Property="ExcludedCodes" />
      </Dialog>

      <!-- Health Monitor Configuration Dialog -->
      <Dialog Id="MonitorConfigDlg" Width="370" Height="270" Title="Health Monitor Configuration">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Title" Type="Text" X="135" Y="80" Width="220" Height="30" NoPrefix="yes" Transparent="yes" Text="{\WixUIHeader}Health Monitor Configuration" />
        <Control Id="InstallTaskCheck" Type="CheckBox" X="20" Y="105" Width="330" Height="17" Property="InstallScheduledTask" Text="Register health monitor as a Scheduled Task" />
        <Control Id="SmtpLabel" Type="Text" X="20" Y="130" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="SMTP Server:" />
        <Control Id="SmtpEdit" Type="Edit" X="20" Y="145" Width="200" Height="17" Property="SmtpServer" />
        <Control Id="SmtpPortLabel" Type="Text" X="230" Y="130" Width="100" Height="15" NoPrefix="yes" Transparent="yes" Text="Port:" />
        <Control Id="SmtpPortEdit" Type="Edit" X="230" Y="145" Width="50" Height="17" Property="SmtpPort" />
        <Control Id="EmailFromLabel" Type="Text" X="20" Y="165" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="Email From:" />
        <Control Id="EmailFromEdit" Type="Edit" X="20" Y="180" Width="300" Height="17" Property="EmailFrom" />
        <Control Id="EmailUserLabel" Type="Text" X="20" Y="200" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="Email Username:" />
        <Control Id="EmailUserEdit" Type="Edit" X="20" Y="215" Width="200" Height="17" Property="EmailUsername" />
        <Control Id="EmailPassLabel" Type="Text" X="20" Y="235" Width="330" Height="15" NoPrefix="yes" Transparent="yes" Text="Email Password:" />
        <Control Id="EmailPassEdit" Type="Edit" X="20" Y="250" Width="200" Height="17" Property="EmailPassword" Password="yes" />
      </Dialog>

      <!-- Verify Ready Dialog -->
      <Dialog Id="VerifyReadyDlg" Width="370" Height="270" Title="Ready to Install">
        <Control Id="Install" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Install" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Title" Type="Text" X="135" Y="80" Width="220" Height="30" NoPrefix="yes" Transparent="yes" Text="{\WixUIHeader}Ready to Install" />
        <Control Id="Description" Type="Text" X="20" Y="110" Width="330" Height="60" NoPrefix="yes" Transparent="yes" Text="Ready to install [ProductName] on your computer. Click Install to begin." />
      </Dialog>

      <!-- Progress Dialog -->
      <Dialog Id="ProgressDlg" Width="370" Height="270" Title="Installing [ProductName]">
        <Control Id="Title" Type="Text" X="135" Y="80" Width="220" Height="30" NoPrefix="yes" Transparent="yes" Text="{\WixUIHeader}Installing [ProductName]" />
        <Control Id="Description" Type="Text" X="20" Y="110" Width="330" Height="20" NoPrefix="yes" Transparent="yes" Text="Please wait while the installer configures your system." />
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="140" Width="330" Height="12" Sunken="yes" TabSkip="no">
          <Publish Property="ProgressBlocks" Value="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Finish Dialog -->
      <Dialog Id="FinishDlg" Width="370" Height="270" Title="Setup Completed">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Finish" />
        <Control Id="Title" Type="Text" X="135" Y="80" Width="220" Height="30" NoPrefix="yes" Transparent="yes" Text="{\WixUIHeader}Setup Completed" />
        <Control Id="Description" Type="Text" X="20" Y="110" Width="330" Height="60" NoPrefix="yes" Transparent="yes" Text="[ProductName] has been successfully installed. Click Finish to exit." />
      </Dialog>

      <!-- Cancel Dialog -->
      <Dialog Id="CancelDlg" Width="260" Height="85" Title="Cancel Setup">
        <Control Id="No" Type="PushButton" X="120" Y="57" Width="56" Height="17" Default="yes" Text="No" />
        <Control Id="Yes" Type="PushButton" X="60" Y="57" Width="56" Height="17" Text="Yes">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Text" Type="Text" X="48" Y="15" Width="156" Height="30" NoPrefix="yes" Text="Do you want to cancel the installation?" />
      </Dialog>

      <!-- Error Dialog -->
      <Dialog Id="ErrorDlg" Width="330" Height="115" Title="Setup Error">
        <Control Id="Icon" Type="Icon" X="20" Y="20" Width="20" Height="20" FixedSize="yes" IconSize="32" />
        <Control Id="Text" Type="Text" X="48" Y="20" Width="260" Height="60" NoPrefix="yes" Text="[ErrorText]" />
        <Control Id="Ok" Type="PushButton" X="268" Y="85" Width="56" Height="17" Default="yes" Text="OK" />
      </Dialog>
    </UI>

    <!-- Install execute sequence -->
    <InstallExecuteSequence>
      <!-- Remove previous version first -->
      <RemoveExistingProducts Before="InstallInitialize" />

      <!-- Configure appsettings after files are installed -->
      <Custom Action="SetWixAppInstallFolder" After="InstallFiles" />
      <Custom Action="ConfigureAppSettings" After="SetWixAppInstallFolder" />

      <!-- Install service -->
      <Custom Action="InstallWindowsService" After="ConfigureAppSettings" />

      <!-- Start service if requested -->
      <Custom Action="StartWindowsService" After="InstallWindowsService" Condition="StartServiceAfterInstall = yes" />

      <!-- Install scheduled task if requested -->
      <Custom Action="InstallScheduledTaskCA" After="StartWindowsService" Condition="InstallScheduledTask = yes" />

      <!-- Uninstall actions -->
      <Custom Action="UninstallScheduledTaskCA" Before="RemoveFiles" Condition="REMOVE = ALL" />
      <Custom Action="UninstallWindowsService" Before="RemoveFiles" Condition="REMOVE = ALL" />
    </InstallExecuteSequence>
  </Package>
</Wix>
